class RearrangeSign {
    public int[] rearrangeArray(int[] arr) {
        ArrayList<Integer> pos= new ArrayList<>();
        ArrayList<Integer> neg= new ArrayList<>();
        for(int i=0;i<arr.length;i++){
            if(arr[i]>=0) pos.add(arr[i]);
            else neg.add(arr[i]);
        }
        int posi=0;int negi=0;
        int i=0;
        while(posi<pos.size()&&negi<neg.size()){
            if(i%2==0)arr[i++]=pos.get(posi++);
            else arr[i++]=neg.get(negi++);
        }
        while(posi<pos.size()){
           arr[i++]=pos.get(posi++);
        }
        while(negi<neg.size()){
            arr[i++]=neg.get(negi++);
        }
        return arr;

        
    }
}
